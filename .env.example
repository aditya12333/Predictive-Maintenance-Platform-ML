# Copy this file to .env for local overrides. Never commit real secrets.

# Common local settings implemented through Phase 5.
PM_ENVIRONMENT=local
PM_LOG_LEVEL=INFO
PM_DATA_ROOT=data
PM_DATABASE_URL=postgresql+psycopg://pm_app:pm_local_only@localhost:5432/predictive_maintenance

# Local PostgreSQL Compose settings (used by compose.yaml).
POSTGRES_USER=pm_app
POSTGRES_PASSWORD=pm_local_only
POSTGRES_DB=predictive_maintenance
POSTGRES_PORT=5432
PM_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
PM_KAFKA_TOPIC=telemetry.events
PM_KAFKA_CONSUMER_GROUP=telemetry-processor
PM_EVENT_SINK=postgres
PM_REORDER_IDLE_FLUSH_SECONDS=60
# Set only after a model release has passed the approval gate.
# PM_APPROVED_MODEL_MANIFEST_PATH=artifacts/approved-rul-model/manifest.json

# Reserved for a later object-storage integration.
# PM_OBJECT_STORE_ENDPOINT=http://localhost:9000
